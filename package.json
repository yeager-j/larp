{
  "name": "larp-cli",
  "version": "1.0.0",
  "description": "LLM Agent Relay Protocol: lets Claude Code and Codex sessions message each other without knowing each other's harness API.",
  "type": "module",
  "bin": {
    "larp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx src/*.test.ts src/**/*.test.ts",
    "smoke:swarm": "bash scripts/swarm-smoke.sh",
    "smoke:plan:claude": "bash scripts/smoke-plan.sh claude",
    "smoke:plan:codex": "bash scripts/smoke-plan.sh codex",
    "smoke:agent": "bash scripts/smoke-agent.sh",
    "smoke": "bash scripts/smoke.sh",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prepack": "npm run build",
    "prepare": "node .husky/install.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "log-update": "^8.0.0",
    "picocolors": "^1.1.1",
    "string-width": "^8.3.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "prettier --write"
  }
}
